{
  "name": "billflow",
  "productName": "BillFlow",
  "version": "0.2.0",
  "description": "Local-first freelance invoicing and task execution workspace",
  "author": "Akatsuki-61",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "dev:electron": "concurrently -k \"next dev --hostname 127.0.0.1\" \"npm:electron:watch\"",
    "electron:watch": "wait-on tcp:127.0.0.1:3000 && tsup --watch --onSuccess \"electron .\"",
    "build:renderer": "next build",
    "build:electron": "tsup && node scripts/generate-runtime-notices.mjs",
    "build": "next build && tsup && node scripts/generate-runtime-notices.mjs",
    "start": "node scripts/start-desktop.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "prepare:native": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "test:desktop": "playwright test --config playwright.config.ts",
    "pack:mac": "npm run build && electron-builder --mac --arm64 --dir --config.directories.output=release/preview-0.2.0 && codesign --force --deep --sign - release/preview-0.2.0/mac-arm64/BillFlow.app"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "echarts": "^6.1.0",
    "electron": "44.11.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "lucide-react": "^1.48.0",
    "motion": "^14.0.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.1"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    },
    "tsup": {
      "esbuild": "^0.28.2"
    },
    "vite": {
      "esbuild": "^0.28.2"
    },
    "bundle-require": {
      "esbuild": "^0.28.2"
    }
  }
}
